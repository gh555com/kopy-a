### 4. 渲染进程 (`renderer.js`)

这是所有逻辑的核心，是 `ClipboardMonitor` 和 `TransparentPopup` 两个类的 JavaScript 再现。

```javascript
// renderer.js
const { clipboard } = require('electron');
const fs = require('fs').promises; // 使用 promise 版本的 fs
const path = require('path');
const os = require('os');

// --- (v4.9.32) 核心改动：使用 Web Audio API 替换 Pygame Mixer ---
class AudioEngine {
    constructor() {
        this.audioContext = null;
        this.soundBuffers = { main: [], q: [], z: [] };
        this.lastPlayed = { main: null, q: null, z: null };
        this.isInitialized = false;
    }

    async init() {
        try {
            this.audioContext = new (window.AudioContext || window.webkitAudioContext)();
            // 解锁 AudioContext (某些浏览器需要用户交互后才能播放)
            if (this.audioContext.state === 'suspended') {
                await this.audioContext.resume();
            }
            console.log("Web Audio API (低延迟模式) 初始化成功。");
            this.isInitialized = true;
            await this.loadAllSounds();
        } catch (e) {
            console.error("【!!】 Web Audio API 初始化失败:", e);
        }
    }

    async loadSound(filePath) {
        try {
            const response = await fetch(filePath);
            const arrayBuffer = await response.arrayBuffer();
            return await this.audioContext.decodeAudioData(arrayBuffer);
        } catch (e) {
            console.error(`无法加载或解码音效: ${filePath}`, e);
            return null;
        }
    }

    async loadAllSounds() {
        if (!this.isInitialized) return;
        const assetsDir = './assets';

        const loadGroup = async (prefix, range) => {
            const buffers = [];
            for (let i = range[0]; i <= range[1]; i++) {
                const p = path.join(assetsDir, `${prefix}${i}.wav`); // 假设是 .wav，可修改
                try {
                    // 检查文件是否存在
                    await fs.access(p);
                    const buffer = await this.loadSound(p);
                    if (buffer) buffers.push(buffer);
                } catch (e) { /* 文件不存在，跳过 */ }
            }
            return buffers;
        };

        this.soundBuffers.main = await loadGroup('', [1, 8]);
        this.soundBuffers.q = await loadGroup('q', [1, 9]);
        this.soundBuffers.z = await loadGroup('z', [1, 6]);

        console.log(`成功预加载 ${this.soundBuffers.main.length} 个原有音效。`);
        console.log(`成功预加载 ${this.soundBuffers.q.length} 个 q 系列音效。`);
        console.log(`成功预加载 ${this.soundBuffers.z.length} 个 z 系列音效。`);
    }

    playSound(type) {
        if (!this.isInitialized || !this.soundBuffers[type] || this.soundBuffers[type].length === 0) return;

        const source = this.audioContext.createBufferSource();
        const soundBuffer = this.getRandomSound(type);
        source.buffer = soundBuffer;
        source.connect(this.audioContext.destination);
        source.start(0);
        this.lastPlayed[type] = soundBuffer;
    }

    getRandomSound(type) {
        let candidates = this.soundBuffers[type].filter(b => b !== this.lastPlayed[type]);
        if (candidates.length === 0) {
            candidates = this.soundBuffers[type];
        }
        return candidates[Math.floor(Math.random() * candidates.length)];
    }
}

// --- ClipboardMonitor (JS 版本) ---
class ClipboardMonitor {
    constructor() {
        this.audioEngine = new AudioEngine();
        this.lastClipboardContent = this.readClipboard();
        this.cooldown = false;
        this.COOLDOWN_TIME_MS = 100;
        this.activePopup = null;

        // 颜色模式
        this.COLOR_SCHEME_MODE = 4;
        this.currentColorMode = 0;
    }

    async start() {
        await this.audioEngine.init();
        setInterval(() => this.onClipboardChanged(), 200); // 轮询检查剪贴板
        console.log("剪贴板监控已启动。");
    }

    readClipboard() {
        // Electron 的 clipboard API 可以读取多种格式
        // 为简化，我们优先文本，然后图片
        const text = clipboard.readText();
        const image = clipboard.readImage();

        if (text) return { type: 'text', content: text };
        if (!image.isEmpty()) return { type: 'image', content: image.getSize() };
        return { type: 'empty', content: null };
    }

    isContentSame(a, b) {
        if (a.type !== b.type) return false;
        if (a.type === 'text') return a.content === b.content;
        if (a.type === 'image') return a.content.width === b.content.width && a.content.height === b.content.height;
        return true;
    }

    formatSize(sizeBytes) {
        if (sizeBytes < 1024) return `${Math.round(sizeBytes)} b`;
        const kb = sizeBytes / 1024.0;
        if (kb < 1024) return `${Math.round(kb)} K`;
        const mb = kb / 1024.0;
        return `${Math.round(mb)} M`;
    }

    onClipboardChanged() {
        if (this.cooldown) return;

        const currentContent = this.readClipboard();
        if (this.isContentSame(currentContent, this.lastClipboardContent)) {
            return;
        }

        this.lastClipboardContent = currentContent;
        let data;

        if (currentContent.type === 'text') {
            const size = new TextEncoder().encode(currentContent.content).length;
            data = {
                type: "text",
                full_text: currentContent.content,
                bottom_text: this.formatSize(size)
            };
        } else if (currentContent.type === 'image') {
            data = {
                type: "image",
                full_text: `${currentContent.content.width}×${currentContent.content.height}`,
                bottom_text: `截图` // 尺寸计算需要更复杂逻辑，这里简化
            };
        } else {
            return; // 不处理空内容
        }

        this.audioEngine.playSound('main');

        if (this.activePopup && this.activePopup.isSticky) {
            this.setCooldown();
            return;
        }

        if (this.activePopup) {
            this.activePopup.slideOut();
        }

        // 更新颜色模式
        if (this.COLOR_SCHEME_MODE === 4) this.currentColorMode = 1 - this.currentColorMode;

        this.activePopup = new TransparentPopup(data, this, this.currentColorMode);
        this.setCooldown();
    }

    setCooldown() {
        this.cooldown = true;
        setTimeout(() => { this.cooldown = false; }, this.COOLDOWN_TIME_MS);
    }
}


// --- TransparentPopup (JS/DOM 版本) ---
class TransparentPopup {
    constructor(data, monitor, colorMode) {
        this.monitor = monitor;
        this.data = data;
        this.colorMode = colorMode;

        this.isSticky = false;
        this.isZZoneBlocked = false;
        this.zStateIsA = true; // true = Red, false = Blue

        this.LIFECYCLE_SECONDS = 19;
        this.lifecycleTimer = null;

        this.el = {
            container: document.getElementById('popup-container'),
            topContent: document.getElementById('top-content'),
            bottomMessage: document.getElementById('bottom-message'),
            shield: document.getElementById('interaction-shield'),
            zArea: document.getElementById('z-click-area'),
        };

        this.setupUI();
        this.addEventListeners();
        this.slideIn();
        this.startLifecycle();
    }

    setupUI() {
        // 设置文本
        this.el.topContent.innerText = this.data.full_text;
        this.el.bottomMessage.innerText = this.data.bottom_text;

        // 设置主题
        this.el.container.className = this.colorMode === 0 ? 'theme-dark' : 'theme-light';
    }

    addEventListeners() {
        // Q区点击
        this.el.shield.onclick = () => {
            if (!this.isSticky) {
                this.monitor.audioEngine.playSound('q');
                this.slideOut();
            }
        };

        // Z区点击 (快慢逻辑分离)
        this.el.zArea.onclick = () => {
            // --- "快逻辑" ---
            this.monitor.audioEngine.playSound(this.zStateIsA ? 'z' : 'q');
            this.el.zArea.classList.toggle('z-state-b');
            this.zStateIsA = !this.zStateIsA;

            // --- "慢逻辑" (异步防抖) ---
            if (this.isZZoneBlocked) return;
            this.isZZoneBlocked = true;
            setTimeout(() => this.performStickyToggleOnly(), 0);
        };

        // 允许在粘滞模式下复制时播放声音
        this.el.topContent.addEventListener('copy', (event) => {
            if (this.isSticky && this.el.topContent.selectionStart !== this.el.topContent.selectionEnd) {
                this.monitor.audioEngine.playSound('main');
                this.monitor.setCooldown();
            }
        });
    }

    performStickyToggleOnly() {
        this.toggleStickyMode();
        this.isZZoneBlocked = false; // 解锁
    }

    toggleStickyMode() {
        this.isSticky = !this.isSticky;
        if (this.isSticky) {
            this.stopLifecycle();
            this.el.container.classList.add('sticky-mode');
            this.el.shield.style.display = 'none'; // 隐藏屏蔽层
            this.el.topContent.setAttribute('contenteditable', 'true'); // 允许编辑
            this.el.topContent.focus();
        } else {
            this.startLifecycle();
            this.el.container.classList.remove('sticky-mode');
            this.el.shield.style.display = 'block'; // 显示屏蔽层
            this.el.topContent.setAttribute('contenteditable', 'false'); // 禁止编辑

            // 重置Z区状态
            this.el.zArea.classList.remove('z-state-b');
            this.zStateIsA = true;
        }
    }

    startLifecycle() {
        clearTimeout(this.lifecycleTimer);
        this.lifecycleTimer = setTimeout(() => this.slideOut(), this.LIFECYCLE_SECONDS * 1000);
    }

    stopLifecycle() {
        clearTimeout(this.lifecycleTimer);
    }

    slideIn() {
        this.el.container.classList.add('slide-in');
    }

    slideOut() {
        if (this.el.container.classList.contains('slide-out')) return; // 防止重复触发
        this.stopLifecycle();
        this.el.container.classList.remove('slide-in');
        this.el.container.classList.add('slide-out');

        // 动画结束后，旧的 popup 实例会被新的覆盖，无需手动清理DOM
        this.monitor.activePopup = null;
    }
}

// --- 程序启动 ---
document.addEventListener('DOMContentLoaded', () => {
    const monitor = new ClipboardMonitor();
    monitor.start();
});
